global:
  scrape_interval: 60s        # 1 sample/min per series — Grafana Cloud free tier is billed at 1 DPM
  scrape_timeout: 10s
  external_labels:
    app: taskpilot
    env: '__APP_ENV__'
scrape_configs:
  - job_name: taskpilot-backend
    metrics_path: /actuator/prometheus
    scheme: http
    basic_auth:
      username: '__SCRAPE_USERNAME__'
      password_file: /tmp/prom-agent/scrape_password
    static_configs:
      - targets: ['127.0.0.1:__APP_PORT__']
remote_write:
  - url: '__REMOTE_WRITE_URL__'
    basic_auth:
      username: '__PROM_USERNAME__'
      password_file: /tmp/prom-agent/remote_write_token
